% HEADERS
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt} % no line in header area
\fancyhead[C]{\MakeUppercase{\axProjectName}} 
\fancyfoot[C]{\MakeUppercase{\axDocumentName~-~Página~\thepage}}
% ALIGNMENT
% Centering and making chapters uppercase
\titleformat{\chapter}[hang]
  {\sffamily\huge\bfseries\raggedright}
  {\thechapter~}
  {1em}
  {\Huge\MakeUppercase}
% Centering and making sections uppercase
\titleformat{\section}
  {\sffamily\Large\bfseries\raggedright}
  {\MakeUppercase{\thesection}}{1em}{\Large\MakeUppercase}

\titleformat{\subsection}
  {\sffamily\large\bfseries\raggedright}
  {\MakeUppercase{\thesubsection}}{1em}{\large\MakeUppercase}

